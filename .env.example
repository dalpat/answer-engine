# --- Database (swap to a postgres:// URL later; see docs/spec.html §10/§11) ---
DATABASE_URL=file:./data/app.db

# --- Self-hosted search ---
SEARXNG_URL=http://localhost:8080

# --- Encryption for BYOK keys at rest (AES-256-GCM) ---
# Generate with:  openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_KEY

# --- Auth session cookie ---
# Generate with:  openssl rand -base64 32
SESSION_SECRET=CHANGE_ME_RANDOM_SECRET

# --- Public origin (adapter-node) ---
# REQUIRED in production: SvelteKit's CSRF check rejects form POSTs unless this
# matches the URL users hit. Set to your real origin, e.g. https://ae.example.com
# (Not needed for `vite dev`, which infers its own origin.)
ORIGIN=http://localhost:3000
