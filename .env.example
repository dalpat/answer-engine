# --- Database ---
# Local file (default). For a networked DB, point at a remote libSQL/Turso
# instance — same driver, same schema, drop-in:  libsql://your-db.turso.io
# (True Postgres would need a pg-core schema fork — see docs/spec.html §10.)
DATABASE_URL=file:./data/app.db

# --- Search backend ---
#   searxng     self-hosted metasearch — most complete, but needs a running instance
#   wikipedia   keyless, reliable, no service — Wikipedia-only (great when you have neither
#               SearXNG nor working general web search)
#   duckduckgo  keyless general web — but rate-limited / challenged on many networks
#   parallel    hosted general web via Parallel Search MCP — no API key, limited free usage
# If you have no SearXNG running, use 'wikipedia' (works everywhere) or 'duckduckgo'.
SEARCH_BACKEND=wikipedia
SEARXNG_URL=http://localhost:8080

# --- Optional: headless-browser extraction fallback for JS-heavy pages ---
# Set to 1 AND `npm i playwright && npx playwright install chromium` to enable.
# EXTRACT_BROWSER=1

# --- Encryption for BYOK keys at rest (AES-256-GCM) ---
# Generate with:  openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_KEY

# --- Auth session cookie ---
# Generate with:  openssl rand -base64 32
SESSION_SECRET=CHANGE_ME_RANDOM_SECRET

# --- Public origin (adapter-node) ---
# REQUIRED in production: SvelteKit's CSRF check rejects form POSTs unless this
# matches the URL users hit. Set to your real origin, e.g. https://ae.example.com
# (Not needed for `vite dev`, which infers its own origin.)
ORIGIN=http://localhost:3000
